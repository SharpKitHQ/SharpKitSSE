<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
        <PackageReference Include="Nifly" Version="1.1.0" />
        <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
        <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
        <PackageReference Include="Vortice.DirectX" Version="3.8.3" />
        <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
        <PackageReference Include="Vortice.Mathematics" Version="2.1.1" />
        <PackageReference Include="Mutagen.Bethesda" Version="0.54.4" />
    </ItemGroup>

    <ItemGroup>
      <None Include="Shaders\Triangle.hlsl">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="Shaders\Model.hlsl">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
