<Window x:Class="SharpKit.Windows.Dialogs.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SharpKit.Windows.Dialogs"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="140" Width="300"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="CenterOwner">
    <Window.DataContext>
        <local:TextInputDialogVM />
    </Window.DataContext>
    
    <StackPanel Orientation="Vertical" Margin="10">
        <Label Content="{Binding Description}" />
        <TextBox Text="{Binding Input}" Margin="0, 5, 0, 0" />
        
        <StackPanel Orientation="Horizontal" Margin="0, 10, 0, 0" HorizontalAlignment="Right">
            <Button Padding="5, 2, 5, 2" Margin="0, 0, 10, 0" IsDefault="True" Click="Ok_OnClick">OK</Button>
            <Button Padding="5, 2, 5, 2" IsCancel="True" Click="Cancel_OnClick">Cancel</Button>
        </StackPanel>
    </StackPanel>
</Window>
