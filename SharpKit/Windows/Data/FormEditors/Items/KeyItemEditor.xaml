<Window x:Class="SharpKit.Windows.Data.FormEditors.Items.KeyItemEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:misc="clr-namespace:SharpKit.Controls.Data.Misc"
        mc:Ignorable="d"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Title="Key" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Orientation="Vertical" Margin="0, 0, 10, 0">
            <Label>ID</Label>
            <TextBox Text="{Binding EditorID}" />
            
            <Label>Name</Label>
            <TextBox Text="{Binding KeyName}" />
            
            <Grid RowDefinitions="*" ColumnDefinitions="Auto,*,Auto,*" Margin="0, 10, 0, 0">
                <Label Grid.Column="0">Weight</Label>
                <TextBox Grid.Column="1" Text="{Binding Weight}" />
                <Label Grid.Column="2">Value</Label>
                <TextBox Grid.Column="3" Text="{Binding Value}" />
            </Grid>
            
            <StackPanel Orientation="Horizontal" Margin="0, 10, 0, 0" HorizontalAlignment="Center">
                <CheckBox IsChecked="{Binding Playable}" VerticalAlignment="Center" />
                <Label VerticalAlignment="Center">Playable</Label>
            </StackPanel>
            
            <Button Margin="0, 10, 0, 0" IsEnabled="False">Add Destruction Data</Button>
            
            <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" Margin="0, 10, 0, 0">
                <Label Grid.Column="0" Grid.Row="0" HorizontalAlignment="Center">Pickup Sound</Label>
                <Label Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center">Putdown Sound</Label>
                
                <Button IsEnabled="False" Grid.Column="0" Grid.Row="1" Margin="0, 0, 5, 0">Select Sount</Button>
                <Button IsEnabled="False" Grid.Column="1" Grid.Row="1">Select Sount</Button>
            </Grid>
            
            <Grid ColumnDefinitions="*, Auto" RowDefinitions="*,*" Margin="0, 10, 0, 0">
                <Label Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Center">Model</Label>
                
                <TextBox IsReadOnly="True" Text="{Binding Model}" Grid.Column="0" Grid.Row="1" Margin="0, 0, 10, 0" />
                <Button Grid.Row="1" Grid.Column="1" IsEnabled="False">Edit</Button>
            </Grid>
        </StackPanel>
        
        <misc:PapyrusScriptList Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Scripts}" />
        
        <Grid Grid.Column="1" Grid.Row="1" RowDefinitions="Auto,*">
            <Label>Keywords</Label>
            
            <ListBox VerticalAlignment="Stretch" ItemsSource="{Binding Keywords}" Grid.Row="1" SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding EditorID}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="New" />
                        <MenuItem Header="Add" />
                        <MenuItem Header="Delete" />
                        <Separator />
                        <MenuItem Header="Copy" />
                        <MenuItem Header="Paste" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </Grid>
        
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" ColumnDefinitions="*,*" Margin="0, 10, 0, 0">
            <Button HorizontalAlignment="Center" Grid.Column="0" IsDefault="True" Click="OkButton_OnClick">OK</Button>
            <Button HorizontalAlignment="Center" Grid.Column="1" IsCancel="True" Click="CancelButton_OnClick">Cancel</Button>
        </Grid>
    </Grid>
</Window>
