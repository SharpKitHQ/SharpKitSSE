<util:RecordEditorWindow x:TypeArguments="skyrim:IArmorAddonGetter" x:Class="SharpKit.Windows.Data.FormEditors.Items.ArmorAddonEditor"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:local="clr-namespace:SharpKit.Windows.Data.FormEditors.Items"
                         xmlns:util="clr-namespace:SharpKit.Util"
                         xmlns:skyrim="clr-namespace:Mutagen.Bethesda.Skyrim;assembly=Mutagen.Bethesda.Skyrim"
                         mc:Ignorable="d"
                         Title="ArmorAddonEditor" Height="450" Width="800" x:Name="Root">
    <Grid>
        <StackPanel Orientation="Vertical">
            <TextBox Text="{Binding FemaleModel.File.GivenPath, ElementName=Root}"></TextBox>
            <Button Click="Select_Female_OnClick">Select</Button>
        </StackPanel>
    </Grid>
</util:RecordEditorWindow>
