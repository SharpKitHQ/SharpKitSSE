<Window x:Class="SharpKit.Windows.Data.FormEditors.Miscellaneous.KeywordEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Keyword" Height="200" Width="300" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    
    <StackPanel Orientation="Vertical" Margin="5">
        <Label>ID</Label>
        <TextBox Text="{Binding ID, UpdateSourceTrigger=PropertyChanged}" />
        
        <Grid ColumnDefinitions="*, *" Margin="0, 10, 0, 0">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="0, 5, 0, 0">
                    <Label Width="20">R</Label>
                    <TextBox Width="30" Text="{Binding R, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                
                <StackPanel Orientation="Horizontal"  Margin="0, 5, 0, 0">
                    <Label Width="20">G</Label>
                    <TextBox Width="30" Text="{Binding G, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                
                <StackPanel Orientation="Horizontal"  Margin="0, 5, 0, 0">
                    <Label Width="20">B</Label>
                    <TextBox Width="30" Text="{Binding B, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
            
            <StackPanel Orientation="Vertical" Grid.Column="1">
                <Border Width="40" Height="30" Background="Gray" />
                <Button Margin="0, 5, 0, 0">Select Color</Button>
            </StackPanel>
        </Grid>
        
        <StackPanel Orientation="Horizontal" Margin="0, 10, 0, 0" HorizontalAlignment="Center">
            <Button Margin="0, 0, 10, 0">OK</Button>
            <Button>Cancel</Button>
        </StackPanel>
    </StackPanel>
</Window>
