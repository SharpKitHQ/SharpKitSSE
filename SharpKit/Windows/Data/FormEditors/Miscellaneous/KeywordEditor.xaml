<util:DialogWindow x:Class="SharpKit.Windows.Data.FormEditors.Miscellaneous.KeywordEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:util="clr-namespace:SharpKit.Util"
        mc:Ignorable="d"
        x:Name="Root"
        Title="Keyword" Height="200" Width="300" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    
    <StackPanel Orientation="Vertical" Margin="5">
        <Label>ID</Label>
        <TextBox Text="{Binding ID, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" />
        
        <Grid ColumnDefinitions="*, *" Margin="0, 10, 0, 0">
            <StackPanel Orientation="Vertical" Grid.Column="1">
                <Border Width="40" Height="30" Background="{Binding ColorBrush, ElementName=Root}" />
                <Button Margin="0, 5, 0, 0" x:Name="PickColorBtn" Click="PickColorBtn_OnClick">Select Color</Button>
            </StackPanel>
        </Grid>
        
        <StackPanel Orientation="Horizontal" Margin="0, 10, 0, 0" HorizontalAlignment="Center">
            <Button IsDefault="True" Margin="0, 0, 10, 0" x:Name="OkButton" Click="OkButton_OnClick">OK</Button>
            <Button IsCancel="True" x:Name="CancelBtn" Click="CancelBtn_OnClick">Cancel</Button>
        </StackPanel>
    </StackPanel>
</util:DialogWindow>
