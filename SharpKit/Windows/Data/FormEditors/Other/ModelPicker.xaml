<Window x:Class="SharpKit.Windows.Data.FormEditors.Other.ModelPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SharpKit.Windows.Data.FormEditors.Other"
        xmlns:controls="clr-namespace:SharpKit.Controls"
        mc:Ignorable="d"
        Title="Model Data" Height="450" Width="600"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        x:Name="Root">
    <Grid ColumnDefinitions="*,*" Margin="10" RowDefinitions="*,Auto">
        <Grid RowDefinitions="Auto,Auto,Auto,*" Grid.Column="0" Margin="0, 0, 10, 0">
            <Label HorizontalAlignment="Center" Grid.Row="0">Model File Name</Label>
            <Grid ColumnDefinitions="*,Auto" Grid.Row="1">
                <TextBox Margin="0, 0, 10, 0" Text="{Binding ModelPath, ElementName=Root}"></TextBox>
                <Button Grid.Column="1">Select</Button>
            </Grid>
            
            <Label Margin="0, 10, 0, 0" Grid.Row="2">Alternate Textures</Label>
            
            <DataGrid x:Name="TextureGrid" Margin="0, 5, 0, 0" Grid.Row="3" AutoGenerateColumns="False" ItemsSource="{Binding AlternateTextures, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="3D Name" Binding="{Binding Name3D, Mode=OneWay}" />
                    <DataGridTextColumn Header="3D Index" Binding="{Binding Index3D, Mode=OneWay}" />
                    <DataGridTextColumn Header="New Texture" Binding="{Binding Texture.EditorID, Mode=OneWay}" />
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="New" Click="Grid_New_OnClick" />
                        <MenuItem Header="Delete" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Grid>
        
        <controls:ModelPreviewControl Grid.Column="1" ModelPath="{Binding ModelPath, ElementName=Root}" TextureSetOverrides="{Binding TextureSetOverrides, ElementName=Root}" />
        
        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.ColumnSpan="2" Margin="0, 10, 0, 0" HorizontalAlignment="Center">
            <Button IsDefault="True" Click="Ok_OnClick" Margin="0, 0, 5, 0">OK</Button>
            <Button IsCancel="True" Click="Cancel_OnClick">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
