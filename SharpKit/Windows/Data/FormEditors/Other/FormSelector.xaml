<Window x:Class="SharpKit.Windows.Data.FormEditors.Other.FormSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="FormSelector" Height="450" Width="800"
        x:Name="Root">
    <Grid RowDefinitions="Auto,*,Auto" Margin="10">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <Label Grid.Column="0">Filter</Label>
            <TextBox Grid.Column="1" Text="{Binding SearchQuery, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" KeyUp="Search_KeyUp" />
        </Grid>
        
        <ListBox x:Name="ItemsList" Grid.Row="1" Margin="0, 10, 0, 0" ItemsSource="{Binding FilteredItems, Mode=OneWay, ElementName=Root}" SelectedItem="{Binding SelectedItem, ElementName=Root}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding EditorID}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button IsDefault="True" x:Name="OkButton" Click="OkButton_OnClick" HorizontalAlignment="Center" Padding="15, 2, 15, 2" Margin="0, 10, 5, 0">OK</Button>
            <Button IsCancel=" True" x:Name="CancelButton" Click="CancelButton_OnClick" HorizontalAlignment="Center" Padding="15, 2, 15, 2" Margin="0, 10, 0, 0">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
