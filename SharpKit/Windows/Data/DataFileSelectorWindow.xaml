<Window x:Class="SharpKit.Windows.Data.DataFileSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SharpKit.Windows.Data"
        xmlns:converters="clr-namespace:SharpKit.Converters"
        mc:Ignorable="d"
        Title="DataFileSelectorWindow" 
        Height="650" Width="800"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    
    <Window.DataContext>
        <local:DataFileSelectorWindowVM />
    </Window.DataContext>
    
    <Window.Resources>
        <converters:FilenameEqualsConverter x:Key="FilenameEqualsConverter" />
        <converters:ActiveFileConverter x:Key="ActiveFileConverter" />
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Vertical" Grid.Column="0" VerticalAlignment="Stretch" Margin="0, 0, 10, 0">
            <Label>Filter plugin files</Label>
            <TextBox Margin="0, 5, 0, 0" Text="{Binding SearchString, UpdateSourceTrigger=PropertyChanged}"  />
            
            <ListBox Margin="0,10,0,0"
                     ItemsSource="{Binding FilteredPlugins}"
                     Height="450"
                     SelectionChanged="Selector_OnSelectionChanged"
                     SelectionMode="Single"
                     MouseDoubleClick="Selector_OnDoubleClick"
                     x:Name="Selector">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMaster}" Value="True">
                                <Setter Property="Background" Value="Red" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding Selected, Mode=OneWay}"
                                      IsHitTestVisible="False"
                                      Focusable="False"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0" />

                            <TextBlock Text="{Binding Filename}"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Normal" />

                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource ActiveFileConverter}">
                                                        <Binding Path="Filename" />
                                                        <Binding Path="DataContext.ActiveItem" RelativeSource="{RelativeSource AncestorType={x:Type ListBox}}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>

                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        
        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0, 0, 10, 0">
            <Label>Created By</Label>
            <TextBox Margin="0, 5, 0, 0" Text="{Binding SelectedItem.CreatedBy, Mode=OneWay}" TextWrapping="Wrap" IsReadOnly="True" />
            
            <Label Margin="0, 10, 0, 0">Summary</Label>
            <TextBox Height="350" Margin="0, 5, 0, 0" Text="{Binding SelectedItem.Summary, Mode=OneWay}" TextWrapping="Wrap" IsReadOnly="True"  />
            
            <TextBlock Margin="0, 10, 0, 0"><Run>Created on</Run> <Run Text="{Binding SelectedItem.CreatedOn}" /></TextBlock>
            <TextBlock Margin="0, 5, 0, 0"><Run>Last modified on</Run> <Run Text="{Binding SelectedItem.LastModified}" /></TextBlock>
        </StackPanel>
        
        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Stretch" Grid.Column="2">
            <Label>Parent Masters</Label>
            <ListBox Height="410" Margin="0, 5, 0, 0" ItemsSource="{Binding SelectedItem.ParentMasters}" />
        </StackPanel>
        
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="*, *">
            <Grid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Height" Value="28" />
                    <Setter Property="Padding" Value="10, 5"></Setter>
                    <Setter Property="Margin" Value="0 0, 10, 0"></Setter>
                </Style>
            </Grid.Resources>
            
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
                <Button Click="SetActiveFile_OnClick">Set as Active File</Button>
                <Button>Details...</Button>
            </StackPanel>
            
            <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button HorizontalAlignment="Right" Click="Ok_OnClick">OK</Button>
                <Button HorizontalAlignment="Right" Click="Cancel_OnClick">Cancel</Button>
            </StackPanel>
        </Grid>
        
        
    </Grid>
</Window>
