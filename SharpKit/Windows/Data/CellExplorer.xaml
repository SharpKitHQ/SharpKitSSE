<Window x:Class="SharpKit.Windows.Data.CellExplorer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:SharpKit.Converters"
             xmlns:formEditors="clr-namespace:SharpKit.Windows.Data.FormEditors"
             mc:Ignorable="d"
             Width="300" Height="300">
    
    <Window.Resources>
        <converters:TranslatedStringConverter x:Key="TraStrConv" />
    </Window.Resources>
    
    <Window.DataContext>
        <formEditors:CellExplorerVM />
    </Window.DataContext>
    
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,*" Margin="10">
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0, 0, 10, 0">
            <ComboBox ItemsSource="{Binding Worldspaces}" SelectedItem="{Binding SelectedWorldspace}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name, Mode=OneWay}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>
        </StackPanel>
        
        <DataGrid x:Name="CellGrid" Grid.Row="1" Grid.Column="0" Margin="0, 10, 10, 0" 
                  ItemsSource="{Binding SelectedCells}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single"
                  KeyUp="CellList_KeyUp"
                  MouseDoubleClick="CellGrid_OnMouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="EditorID" Binding="{Binding EditorID}" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay, Converter={StaticResource TraStrConv}}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
