<UserControl x:Class="SharpKit.Controls.Data.Misc.KeywordListEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SharpKit.Controls.Data.Misc"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             x:Name="Root">
    <GroupBox Header="Keywords" HorizontalAlignment="Stretch">
        <ListBox x:Name="KeywordList" Margin="5" 
                 ItemsSource="{Binding ItemsSource, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                 SelectionMode="Extended">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="New" Click="New_OnClick" />
                    <MenuItem Header="Add" Click="Add_OnClick" />
                    <MenuItem Header="Delete" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding EditorID}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </GroupBox>
</UserControl>
